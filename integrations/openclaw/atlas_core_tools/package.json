{
  "name": "@atlas/openclaw-atlas-core-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bounded OpenClaw tools for reading ATLAS V4 projections and submitting plan revision proposals.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "validate": "npm run build && openclaw plugins validate --entry ./dist/index.js"
  },
  "files": [
    "dist",
    "contracts/v4",
    "openclaw.plugin.json",
    "README.md"
  ],
  "dependencies": {
    "typebox": "1.3.34"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "openclaw": "2026.10.5",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
