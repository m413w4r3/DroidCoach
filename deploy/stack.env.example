# Copy this file to ~/.config/atlas/stack.env and set mode 0600.
# Values are paths and non-secret settings only. Secret material stays in files.
ATLAS_IMAGE_TAG=local

ATLAS_TOKEN_FILE=${HOME}/.local/state/atlas-core/secrets/v7-12/atlas-token
ATLAS_TOOL_TOKEN_FILE=${HOME}/.local/state/atlas-core/secrets/v7-12/atlas-tool-token
OPENCLAW_GATEWAY_TOKEN_FILE=${HOME}/.local/state/atlas-core/secrets/v7-12/openclaw-gateway-token

ATLAS_RELAY_ASSERTION_KEYS_FILE=${HOME}/.local/state/atlas-core/secrets/v7-12/relay-assertion-keys.json
CORE_CURSOR_SECRET_FILE=${HOME}/.local/state/atlas-core/secrets/v7-12/cursor-secret
CONNECTOR_ASSERTION_SECRET_FILE=${HOME}/.local/state/atlas-relay/v7-12/relay-assertion-secret
CONNECTOR_PRINCIPAL_MAP_FILE=${HOME}/.local/state/atlas-relay/v7-12/principal-map.json
CONNECTOR_SERVICE_TOKEN_FILE=${HOME}/.local/state/atlas-relay/v7-12/service-token
ATLAS_V4_RELAY_ASSERTION_KEY_ID=replace-with-provisioned-key-id

ATLAS_CONNECTOR_STATE_DIR=${HOME}/.local/state/atlas-relay
OPENCLAW_STATE_DIR=${HOME}/.openclaw
OPENCLAW_UPDATE_CAPTURES_DIR=${HOME}/.openclaw.update-captures
ATLAS_BACKUP_DIR=${HOME}/.local/state/atlas-stack/backups
ATLAS_BACKUP_REQUIRE_ZFS_ENCRYPTION=1

ATLAS_V4_AUTH_MODE=dual
ATLAS_V4_CONNECTOR_AUTH_MODE=dual
# Non-secret principal ID populated after TOOL principal provisioning.
ATLAS_V4_TOOL_PRINCIPAL_ID=
