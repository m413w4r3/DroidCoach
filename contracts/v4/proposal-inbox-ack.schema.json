      "state": "APPLIED",
      "result_code": "APPLIED",
      "occurred_at": "2026-10-29T08:02:04Z",
      "plan_id": "00000000-0000-4000-8000-000000000102",
      "applied_plan_version": 8,
      "revision_id": "00000000-0000-4000-8000-000000000103",
