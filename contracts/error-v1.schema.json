{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.invalid/contracts/error-v1.schema.json",
  "title": "ATLAS API error v1",
  "description": "Stable error envelope returned by the /v1 API. Validation details are intentionally not echoed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "detail", "error"],
  "properties": {
    "contract_version": {"const": 1},
    "detail": {"type": "string"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "authentication_required",
            "policy_denied",
            "not_found",
            "idempotency_conflict",
            "request_rejected",
            "contract_validation_failed",
            "request_too_large",
            "invalid_content_length"
          ]
        },
        "message": {"type": "string"}
      }
    }
  }
}
