{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.invalid/contracts/sport-plan-v1.schema.json",
  "title": "ATLAS sport plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "local_date",
    "timezone",
    "source",
    "sync_state",
    "routine_id",
    "day_id",
    "day_name",
    "planned",
    "exercises",
    "performed",
    "generated_at",
    "limits"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "local_date": {
      "type": ["string", "null"],
      "maxLength": 10,
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "timezone": { "type": ["string", "null"], "minLength": 1, "maxLength": 100 },
    "source": { "type": "string", "enum": ["WGER_READ", "FIXTURE"] },
    "sync_state": {
      "type": "string",
      "enum": ["FRESH", "STALE", "UNAVAILABLE", "MISMATCH"]
    },
    "routine_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128
    },
    "day_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
    "day_name": { "type": ["string", "null"], "maxLength": 120 },
    "planned": { "type": "boolean" },
    "exercises": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["exercise_id", "sets", "reps"],
        "properties": {
          "exercise_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "name": { "type": "string", "maxLength": 120 },
          "sets": { "type": "integer", "minimum": 1, "maximum": 10 },
          "reps": { "type": "integer", "minimum": 0, "maximum": 1000 },
          "weight_kg": { "type": "number", "minimum": 0, "maximum": 1000 },
          "rest_seconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
          "last_performance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["performed_at", "sets"],
            "properties": {
              "performed_at": {
                "type": "string",
                "maxLength": 40,
                "format": "date-time"
              },
              "sets": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["reps"],
                  "properties": {
                    "reps": { "type": "integer", "minimum": 0, "maximum": 1000 },
                    "weight_kg": { "type": "number", "minimum": 0, "maximum": 1000 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "performed": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["result_id", "performed_at", "duration_minutes", "source", "verification"],
        "properties": {
          "result_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "performed_at": { "type": "string", "maxLength": 40, "format": "date-time" },
          "duration_minutes": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 1440
          },
          "source": { "type": "string", "enum": ["WGER_API", "USER_DECLARED", "IMPORTED"] },
          "verification": {
            "type": "string",
            "enum": ["API_READ_BACK", "USER_CONFIRMED", "UNVERIFIED"]
          }
        }
      }
    },
    "generated_at": {
      "type": ["string", "null"],
      "maxLength": 40,
      "format": "date-time"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_exercises", "truncated"],
      "properties": {
        "max_exercises": { "type": "integer", "const": 50 },
        "truncated": { "type": "boolean" }
      }
    }
  }
}
