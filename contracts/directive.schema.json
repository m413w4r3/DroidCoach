{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATLAS Directive v1",
  "description": "Version 1 of the directive DTO returned by GET /v1/directives/current. Timestamps are RFC 3339 UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "directive_id",
    "type",
    "title",
    "reason",
    "choices",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "directive_id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "start_focus_session",
        "habit_checkin",
        "read_content",
        "project_action"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "reason": {
      "type": "string",
      "maxLength": 400
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "estimated_minutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 180
    },
    "choices": {
      "type": "array",
      "items": {
        "enum": [
          "start",
          "discuss",
          "alternative",
          "postpone",
          "pause"
        ]
      },
      "minItems": 4,
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "requires_explicit_confirmation": {
      "type": "boolean",
      "default": false
    }
  }
}
