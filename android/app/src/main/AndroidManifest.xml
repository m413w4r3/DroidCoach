<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- Optional backend sync only. No connection is opened until sync and category consent are enabled. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Local ATLAS calendar only. WRITE_CALENDAR is requested explicitly by the user,
         never granted by the app itself. AUTHENTICATE_ACCOUNTS and the sync settings
         permissions are required to register the dedicated offline sync adapter. -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.AUTHENTICATE_ACCOUNTS" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
            <category android:name="android.intent.category.DEFAULT" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <package android:name="ws.xsoh.etar" />
        <package android:name="ws.xsoh.etar.debug" />
    </queries>

    <application
        android:name=".app.AtlasApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_atlas"
        android:label="ATLAS"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Atlas">

        <activity
            android:name=".app.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".app.LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".usage.android.IntentionActivity"
            android:exported="false" />

        <receiver
            android:name=".focus.android.FocusPhaseAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".focus.android.FocusRoutineProposalReceiver"
            android:exported="false" />
        <receiver
            android:name=".focus.android.FocusRescheduleReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".habits.android.HabitReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".habits.android.HabitReminderRescheduleReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".usage.android.EmergencyPauseReceiver"
            android:exported="false" />

        <service
            android:name=".location.MobilitySessionService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- AccountManager requires a registered authenticator before it accepts
             an explicit local account. This authenticator offers no sign-in and
             no token. -->
        <service
            android:name=".calendar.local.AtlasAccountAuthenticatorService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.ACCOUNT_MANAGER">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/atlas_account_authenticator" />
        </service>

        <!-- Offline sync adapter whose only role is to let CalendarProvider create
             the dedicated local ATLAS calendar. It performs no network sync. -->
        <service
            android:name=".calendar.local.AtlasCalendarSyncService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_SYNC_ADAPTER">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/atlas_calendar_sync_adapter" />
        </service>
    </application>
</manifest>
